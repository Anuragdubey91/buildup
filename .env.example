# ==========================================
# BuildUp Platform — Environment Variables
# ==========================================
# Copy this file to .env.local for local development.
# Keep secrets secure and never commit real credentials.

# ------------------------------------------
# Application URL
# ------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------
# MongoDB Database
# ------------------------------------------
# Connection URI for MongoDB Atlas or local MongoDB instance.
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/buildup?retryWrites=true&w=majority
# If not configured, BuildUp operates in resilient in-memory demo mode.
MONGODB_URI="mongodb://localhost:27017/buildup"

# ------------------------------------------
# Clerk Authentication
# ------------------------------------------
# Get these from your Clerk dashboard (https://dashboard.clerk.com)
# If left empty, BuildUp runs with built-in instant session switcher for testing!
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_sample_clerk_key"
CLERK_SECRET_KEY="sk_test_sample_clerk_key"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/profile"

# ------------------------------------------
# AI Provider Integration
# ------------------------------------------
# Supported providers: "gemini" | "openai" | "heuristic" (default fallback)
AI_PROVIDER="gemini"
# Gemini API Key from Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=""
# Or OpenAI API Key
OPENAI_API_KEY=""
# Configured Model Name (e.g. gemini-1.5-pro, gemini-1.5-flash, gpt-4o-mini)
AI_MODEL_NAME="gemini-1.5-flash"

# ------------------------------------------
# Razorpay Payment Gateway (Test Mode)
# ------------------------------------------
# Get from Razorpay Dashboard (https://dashboard.razorpay.com) -> Settings -> API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_sample_key_id"
RAZORPAY_KEY_SECRET="sample_secret_key"
RAZORPAY_WEBHOOK_SECRET="sample_webhook_secret"

# ------------------------------------------
# Platform Administration
# ------------------------------------------
# Comma-separated user IDs or emails authorized for /admin
ADMIN_EMAILS="admin@buildup.dev,founder@buildup.dev"
