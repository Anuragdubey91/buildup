# ==========================================
# BuildUp Platform — Local Environment Variables
# ==========================================

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# MongoDB Database (Local instance running on localhost:27017)
MONGODB_URI="mongodb://localhost:27017/buildup"

# Clerk Authentication (Leave as sample to use BuildUp MongoDB Session Auth, or paste real live keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_sample_clerk_key"
CLERK_SECRET_KEY="sk_test_sample_clerk_key"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# AI Provider Integration
# Set AI_PROVIDER="gemini" and add GEMINI_API_KEY for live Google Gemini neural inference.
# When empty, BuildUp uses the built-in Smart Heuristic Validation Engine.
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
AI_MODEL_NAME="gemini-1.5-flash"

# Razorpay Payment Gateway (Test Mode)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_sample_key_id"
RAZORPAY_KEY_SECRET="sample_secret_key"
RAZORPAY_WEBHOOK_SECRET="sample_webhook_secret"

# Platform Administration
ADMIN_EMAILS="admin@buildup.dev,founder@buildup.dev"
